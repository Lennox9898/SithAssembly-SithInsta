{
  "version": 1,
  "provider": "clawdbot.you / OpenClaw Gateway",
  "enabled": false,
  "skill_manifest": "CLAWDBOT_SKILL.md",
  "capability_manifest_endpoint": "/api/clawdbot/manifest",
  "gateway": {
    "base_url": "http://127.0.0.1:18789",
    "auth_ref": "env:OPENCLAW_GATEWAY_TOKEN",
    "transport": "local_loopback",
    "profile": "default"
  },
  "bridge": {
    "agent_id": "sithassembly-conclave",
    "dispatch_policy": "not_configured",
    "allowed_sithassembly_endpoints": [
      "/api/runtime",
      "/api/agents",
      "/api/agent-reports",
      "/api/commands"
    ],
    "allowed_openclaw_tools": [],
    "idempotency": "required",
    "operator_notes": "Human-editable. Add a narrow, tested tool allowlist before enabling a dispatcher."
  }
}
