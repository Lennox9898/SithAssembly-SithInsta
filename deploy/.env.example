# Local Docker bind mounts, resolved relative to deploy/.
SITH_HOST_DATA_DIR=../data
SITH_HOST_RUNTIME_DIR=../.runtime
SITH_API_PORT=8080

# Required for the API containers. Use a randomly generated value with 24 or more characters.
SITH_API_TOKEN=
SITH_ALLOWED_HOSTS=127.0.0.1,localhost

# Pin image digests in deploy/.env.local before enabling infrastructure profiles.
SITH_POSTGRES_IMAGE=
SITH_NATS_IMAGE=
SITH_STORAGE_IMAGE=
